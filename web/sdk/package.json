{
  "name": "@holistics/anfra-sdk",
  "version": "0.5.0",
  "description": "Data Apps on anfra: the authoring layer (app), what hosts one (host), the core API client (api), and their shared contract (common)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holistics/anfra.git",
    "directory": "web/sdk"
  },
  "type": "module",
  "exports": {
    "./common": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./ambient": {
      "types": "./dist/ambient.d.ts"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "@holistics:registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup && node scripts/ambient.mjs",
    "test": "TZ=\"Asia/Kuala_Lumpur\" vitest run",
    "test:watch": "TZ=\"Asia/Kuala_Lumpur\" vitest watch",
    "typecheck": "tsc --noEmit",
    "generate": "openapi-typescript ../../api/openapi.yaml --default-non-nullable false -o src/api/schema.d.ts",
    "dev": "tsup --watch",
    "prepack": "cp ../../LICENSE ../../NOTICE ."
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
