{
  "name": "anfra-sdk",
  "version": "0.1.0",
  "description": "Data Apps on anfra: the authoring layer (app), what hosts one (host), the core API client (api), and their shared contract (common)",
  "private": true,
  "type": "module",
  "exports": {
    "./common": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./ambient": {
      "types": "./ambient.d.ts"
    }
  },
  "files": [
    "dist",
    "ambient.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "test": "TZ=\"Asia/Kuala_Lumpur\" vitest run",
    "test:watch": "TZ=\"Asia/Kuala_Lumpur\" vitest watch",
    "typecheck": "tsc --noEmit",
    "generate": "openapi-typescript ../api/openapi.yaml --default-non-nullable false -o src/api/schema.d.ts",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
