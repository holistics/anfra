{
  "name": "anfra-tooling",
  "private": true,
  "description": "Node tooling for the anfra Go repo: commitlint (conventional commits), conventional-changelog, and the Anfra SDK's workspace.",
  "scripts": {
    "prepare": "husky",
    "commit": "cz",
    "changelog": "conventional-changelog -n conventional-changelog.config.mjs -i CHANGELOG.md -s -t anfra-v",
    "bump": "bash scripts/bump.sh",
    "build:sdk": "pnpm --filter anfra-sdk build",
    "dev:sdk": "pnpm --filter anfra-sdk dev",
    "test:sdk": "pnpm --filter anfra-sdk test",
    "build:web": "pnpm build:sdk && pnpm build:appserve",
    "build:appserve": "pnpm --filter anfra-appserve build",
    "dev:appserve": "pnpm --filter anfra-appserve dev",
    "test:appserve": "pnpm --filter anfra-appserve test",
    "test:web": "pnpm test:sdk && pnpm test:appserve"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/cz-commitlint": "^19.6.0",
    "commitizen": "^4.3.1",
    "conventional-changelog-cli": "^5.0.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "husky": "^9.1.7"
  },
  "packageManager": "pnpm@10.22.0",
  "license": "Apache-2.0"
}
